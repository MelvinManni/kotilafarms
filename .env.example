# Copy to .env and fill in. Validated at startup by src/lib/env.ts.
# DB_PORT is the host port for the db container; keep it in step with DATABASE_URL
DB_PORT=5432
DATABASE_URL=postgres://kotila:kotila@localhost:5432/kotila
POSTGRES_USER=kotila
POSTGRES_PASSWORD=kotila
POSTGRES_DB=kotila

# NextAuth (names for v4; if v5 is used, switch to AUTH_SECRET / AUTH_URL)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# First owner created by `pnpm db:seed` (change the password after first sign-in)
SEED_OWNER_EMAIL=kosi@example.com
SEED_OWNER_PASSWORD=change-me-now-please

# Files: receipt photos go to a private S3 bucket (leave S3_ENDPOINT empty for AWS; set it for an S3-compatible store)
S3_BUCKET=kotila-farm-receipts
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
FARM_TIMEZONE=Africa/Lagos
