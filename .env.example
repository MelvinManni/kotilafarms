# Copy to .env and fill in. Validated at startup by src/lib/env.ts.
# DB_PORT is the host port for the local db container; keep it in step with DATABASE_URL
DB_PORT=5432
DATABASE_URL=postgres://kotila:kotila@localhost:5432/kotila
# Production (AWS RDS): DATABASE_URL=postgres://<user>:<password>@<instance>.<id>.<region>.rds.amazonaws.com:5432/kotila?sslmode=verify-full
#   The image trusts Amazon's RDS certificates, so verify-full works. URL-encode special characters in the password.
# Only for running the app container against the local db container: containers reach it as "db", not "localhost"
CONTAINER_DATABASE_URL=
POSTGRES_USER=kotila
POSTGRES_PASSWORD=kotila
POSTGRES_DB=kotila

# NextAuth (names for v4; if v5 is used, switch to AUTH_SECRET / AUTH_URL)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# First owner, made by `pnpm db:setup` or the container's first start on an empty database (remove after first sign-in)
FIRST_OWNER_NAME=Kosi
FIRST_OWNER_EMAIL=kosi@example.com
FIRST_OWNER_PASSWORD=change-me-now-please
# The container sets this to true: the app migrates and makes the first owner on start
DB_SETUP_ON_START=

# Files: receipt photos go to a private S3 bucket (leave S3_ENDPOINT empty for AWS; set it for an S3-compatible store)
S3_BUCKET=kotila-farm-receipts
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
FARM_TIMEZONE=Africa/Lagos

# PDF reports: Chromium for printing. Empty = the Chrome installed on this machine (dev); the Docker image sets it.
CHROMIUM_PATH=
# How the PDF browser reaches the app from inside the server (empty = NEXTAUTH_URL)
INTERNAL_APP_URL=
